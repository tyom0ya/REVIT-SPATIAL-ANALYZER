<Project>

  <!--
    Settings shared by every project in the solution.
    Project-specific settings (target framework, Revit references) stay in the
    individual .csproj files.
  -->
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Product>Revit Spatial Analyzer</Product>
    <Version>0.2.0</Version>
  </PropertyGroup>

  <!--
    Location of the Autodesk Revit 2025 installation that supplies RevitAPI.dll
    and RevitAPIUI.dll.

    These assemblies are referenced from the local install and are deliberately
    NOT redistributed with the add-in, so this path is a build-machine concern
    rather than something committed as a binary. Override it on a machine where
    Revit lives elsewhere:

        dotnet build -p:RevitApiDir="D:\Autodesk\Revit 2025"

    Note that Revit 2027 is also present on some machines. Only 2025 is a valid
    reference source for this project.
  -->
  <PropertyGroup>
    <RevitVersion>2025</RevitVersion>
    <RevitApiDir Condition="'$(RevitApiDir)' == ''">$(ProgramW6432)\Autodesk\Revit $(RevitVersion)</RevitApiDir>
  </PropertyGroup>

</Project>
