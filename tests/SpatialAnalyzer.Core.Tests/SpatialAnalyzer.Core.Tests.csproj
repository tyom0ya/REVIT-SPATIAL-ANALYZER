<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for SpatialAnalyzer.Core.

    These run without Revit, which is the point: the spatial rules that matter
    most to this project (the gap invariant above all) must be provable in a few
    seconds on any machine, not by opening a model and looking at it.

    The xUnit packages here are test-only. They are never referenced by
    SpatialAnalyzer.Revit and never ship with the add-in, so they do not count
    against the project's runtime dependency policy.

    LangVersion, Nullable and ImplicitUsings are inherited from
    Directory.Build.props and deliberately not repeated.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>SpatialAnalyzer.Core.Tests</AssemblyName>
    <RootNamespace>SpatialAnalyzer.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SpatialAnalyzer.Core\SpatialAnalyzer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
