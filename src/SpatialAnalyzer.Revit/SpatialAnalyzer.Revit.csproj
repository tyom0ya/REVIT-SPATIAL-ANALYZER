<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Autodesk adapter layer: everything that touches the Revit API lives
    here, and Revit data is copied into plain owned types before it reaches
    SpatialAnalyzer.Core.

    Targets net8.0-windows because Revit 2025 is itself .NET 8 hosted.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>SpatialAnalyzer.Revit</AssemblyName>
    <RootNamespace>SpatialAnalyzer.Revit</RootNamespace>
  </PropertyGroup>

  <!--
    Resolves the MSB3277 reference conflict at its source.

    RevitAPIUI.dll depends on WindowsBase, System.Drawing and
    Microsoft.VisualBasic. Those live in the Windows Desktop framework, not in
    the base .NET runtime, and Revit keeps its own copies beside RevitAPIUI.dll.
    A net8.0-windows project without this reference has no Windows Desktop
    assemblies to resolve against, so MSBuild finds Revit's copies while
    chasing those dependencies and reports a version conflict against the base
    reference pack — roughly 1300 lines of warning per build.

    Declaring the Windows Desktop framework gives those dependencies a proper
    home and the conflict disappears rather than being hidden: the build is
    clean with no warning suppression anywhere in this project, so a genuinely
    new MSB3277 would still be visible.

    This is the fix Autodesk documents for the .NET 8 migration ("add a
    reference to the Windows Desktop framework"). Note that it is not the same
    as <UseWPF>, which additionally turns on XAML compilation and a WPF
    application model; this project builds no WPF UI.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <!--
    Revit API assemblies.

    Private=false is the MSBuild spelling of "Copy Local = false" and is the
    important part of this file. Revit loads these from its own installation
    directory at runtime; shipping our own copies risks binding an add-in
    against assemblies that disagree with the host, and bloats the installer
    with files Autodesk already provides.

    tools/verify.ps1 enforces the same rule against real build output, because
    a comment is not a guarantee.

    Path comes from $(RevitApiDir) in Directory.Build.props so no machine
    specific path is committed. Revit 2027 is present on some machines and is
    NOT a valid reference source for this project.
  -->
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitApiDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpatialAnalyzer.Core\SpatialAnalyzer.Core.csproj" />
  </ItemGroup>

</Project>
